    "pattern": "(?i)(?:%2e%2e[/\\\\]|%2e%2e/|%2e%2e%5c|%252e%252e)",
    "targets": [
      "URI",
      "ARGS",
      "HEADERS"
    ],
    "severity": "HIGH",
    "action": "block",
    "score": 8,
    "description": "Block URL encoded path traversal patterns."
