    "targets": [
      "URI",
      "ARGS",
      "HEADERS"
    ],
    "severity": "HIGH",
    "action": "block",
    "score": 8,
    "description": "Block basic path traversal patterns using ../ and similar."
  },
  {
    "id": "lfi-url-encoded-path-traversal",
