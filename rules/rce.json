[
    {
        "id": "rce-command-separators",
        "phase": 2,
        "pattern": "(?i)(?:`[^`]+`|(?:^|[;|]|%0a|%0d|\\n)\\s*(?:rm|cat|echo|curl|wget|python[23]?|php|perl|ruby|nc|ncat|cmd|exec|system|passthru|shell_exec|popen|pcntl_exec|uname|whoami|id|hostname|systeminfo|ifconfig|ipconfig|netstat)\\b)",
        "targets": ["ARGS"],
        "severity": "HIGH",
        "action": "block",
        "score": 8,
        "description": "Block a command after a separator. Fixes the old \\b(?:;|...) construct, whose word-boundary before ';' made 'q=;rm' unmatchable, and covers a single pipe (only || matched before). '&' is excluded (query-string separator) and HEADERS was dropped: the evaluated header string joins headers and cookies with semicolons, so a cookie named after a command word would match. Command list also includes OS reconnaissance commands (uname, whoami, hostname, systeminfo, ifconfig/ipconfig, netstat) that follow a separator, recovering the intent of the removed rce-os-info-commands rule without its unanchored 'ver' substring false positive."
    },
 {
        "id": "rce-direct-commands",
        "phase": 2,
        "pattern": "(?i)\\b(?:system|exec|shell_exec|passthru|popen|proc_open|pcntl_exec)\\s*\\([^\\)]*\\)",
        "targets": ["ARGS", "HEADERS"],
        "severity": "HIGH",
         "action": "block",
         "score": 9,
        "description": "Block direct use of RCE execution functions."
    },
     {
        "id": "rce-file-access-patterns",
        "phase": 2,
        "pattern": "(?i)(?:(?:cat|more|less|head|tail|find|grep)\\s+[^\\s]+(?:/etc/(?:passwd|shadow|hosts)|/proc/self/environ|/var/log/|/boot/grub))",
        "targets": ["ARGS", "HEADERS"],
        "severity": "HIGH",
        "action": "block",
        "score": 7,
        "description": "Block attempts to access sensitive files via command-like patterns."
    },
  {
        "id": "rce-network-commands",
        "phase": 2,
        "pattern": "(?i)\\b(?:netstat|route|arp|nmap|traceroute)\\b",
        "targets": ["ARGS", "HEADERS"],
        "severity": "MEDIUM",
        "action": "log",
        "score": 5,
        "description": "Log keywords related to network exploration."
    },
{
       "id": "rce-special-chars-command",
       "phase": 2,
       "pattern": "(?i)(?:[;|]|\\$\\(|`)\\s*(?:cmd|exec|system|passthru|shell_exec|popen|proc_open|pcntl_exec)\\b",
        "targets": ["ARGS"],
       "severity": "HIGH",
        "action":"block",
       "score": 9,
        "description":"Block PHP/OS execution primitives after an injection metacharacter. Same \\b-before-';' fix as rce-command-separators; '&' excluded so a parameter literally named exec/cmd in a multi-param query does not block by position alone."
 },
  {
       "id":"rce-obfuscated-commands",
       "phase": 2,
       "pattern":"(?i)(?:[a-zA-Z]+?=\\s*(?:\\`|\\$\\(|\\$\\{).*?(?:\\`|\\)|\\}))",
       "targets": ["ARGS", "HEADERS"],
       "severity": "MEDIUM",
       "action":"log",
       "score": 5,
       "description":"Log RCE attempts with obfuscated commands using variable assignment and backticks or $() or ${}"
 },
    {
       "id":"rce-powershell-commands",
        "phase": 2,
        "pattern": "(?i)(?:powershell|-EncodedCommand|Invoke-WebRequest|Invoke-Expression|New-Object System.Net.WebClient)",
        "targets": ["ARGS", "HEADERS"],
        "severity":"HIGH",
        "action":"block",
       "score": 8,
        "description":"Block RCE attempts using powershell"
  },
  {
      "id":"rce-php-file-operations",
      "phase": 2,
      "pattern":"(?i)(?:file_get_contents|file_put_contents|fopen|fclose|fwrite|fread|unlink|rename|copy|move_uploaded_file|scandir|glob|readfile|include|require|eval|assert)\\s*\\(",
      "targets": ["ARGS", "HEADERS"],
      "severity":"HIGH",
      "action":"block",
      "score": 8,
      "description": "Block PHP file operation functions in potential RCE."

  },
 {
       "id": "rce-java-exec",
       "phase": 2,
       "pattern": "(?i)(?:Runtime\\s*\\.\\s*getRuntime\\s*\\(\\s*\\)\\s*\\.\\s*exec\\s*\\(|\\bRuntime\\s*\\.\\s*exec\\s*\\(|\\bProcessBuilder\\s*\\(|\\bnew\\s+ProcessBuilder\\b)",
       "targets": ["ARGS", "BODY"],
        "severity": "HIGH",
       "action": "block",
       "score": 8,
       "description": "Block Java command execution: Runtime.getRuntime().exec(...), Runtime.exec(...), and ProcessBuilder(...). Rewrite of the removed rce-java-exec, whose trailing \\s*\\( applied to every branch required a double paren (exec(( ) and so never matched a real getRuntime().exec(\"...\") or ProcessBuilder call. Targets ARGS and BODY (a Java exec API in a request parameter is almost never legitimate)."
    },
    {
       "id": "rce-perl-exec",
       "phase": 2,
       "pattern": "(?i)\\b(?:system|exec|qx|backticks|open)\\s*\\(",
        "targets": ["ARGS", "HEADERS"],
         "severity": "HIGH",
        "action": "block",
       "score": 8,
       "description": "Block Perl execution commands."
    },
    {
      "id":"rce-python-exec",
      "phase": 2,
      "pattern":"(?i)(?:os\\.system\\(|os\\.popen\\(|subprocess\\.call\\(|subprocess\\.Popen\\(|eval\\(|exec\\()",
      "targets": ["ARGS", "HEADERS"],
       "severity":"HIGH",
      "action":"block",
       "score":8,
      "description":"Block python commands for remote execution"
 },
{
       "id":"rce-csharp-exec",
        "phase":2,
        "pattern":"(?i)(?:System.Diagnostics.Process.Start\\(|System.Diagnostics.Process.GetProcessesByName\\()",
        "targets": ["ARGS", "HEADERS"],
        "severity":"HIGH",
        "action":"block",
        "score": 8,
         "description":"Block C# commands for remote code execution"
 },
 {
   "id": "rce-cron-like-scheduling",
    "phase": 2,
    "pattern": "(?i)(?:\\*\\s+\\*\\s+\\*\\s+\\*\\s+.*)|(?:\\d+\\s+\\d+\\s+\\*\\s+\\*\\s+.*)",
    "targets": ["ARGS", "HEADERS"],
    "severity": "MEDIUM",
    "action":"log",
    "score": 4,
    "description":"Log cron like scheduling patterns for RCE attempts"
 }
]
