[
  {
    "id": "rce-command-separators",
    "phase": 2,
    "pattern": "(?i)(?:`[^`]+`|(?:^|[;|]|%0a|%0d|\\n)\\s*(?:rm|cat|echo|curl|wget|python[23]?|php|perl|ruby|nc|ncat|cmd|exec|system|passthru|shell_exec|popen|pcntl_exec)\\b)",
    "targets": [
      "ARGS"
    ],
    "severity": "HIGH",
    "action": "block",
    "score": 8,
    "description": "Block a command after a separator. Fixes the old \\b(?:;|...) construct, whose word-boundary before ';' made 'q=;rm' unmatchable, and covers a single pipe (only || matched before). '&' is excluded (query-string separator) and HEADERS was dropped: the evaluated header string joins headers and cookies with semicolons, so a cookie named after a command word would match."
  },
  {
    "id": "rce-direct-commands",
