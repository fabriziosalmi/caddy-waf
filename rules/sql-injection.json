  {
        "id": "sqli-function-injection",
       "phase": 2,
       "pattern":"(?i)\\b(?:load_file|benchmark|sleep|extractvalue|updatexml|geometrycollection|polygon|multipoint|multilinestring|multipolygon|linestring)\\s*\\(|\\b(?:version|database|current_user|user|schema)\\s*\\(\\s*\\)",
        "targets": ["ARGS", "BODY", "HEADERS", "REQUEST_COOKIES"],
         "severity": "MEDIUM",
        "action": "log",
        "score": 4,
        "description":"Log SQL functions used in injection: error-based/timing/geometry functions taking an argument, plus the no-argument information functions in their call form user()/version()/database()/current_user(). The no-arg functions now require empty parens so legitimate 'user(id: 1)' GraphQL/ORM calls do not match. Score 4 keeps it below the default threshold as a correlation-only signal."

    },
