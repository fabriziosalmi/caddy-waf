[
    {
        "id": "sqli-union-select",
        "phase": 2,
        "pattern": "(?i)\\bunion\\b(?:[\\s(]|\\/\\*.*?\\*\\/|--.*?)?(?:all|distinct)?(?:[\\s(]|\\/\\*.*?\\*\\/|--.*?)?\\bselect\\b",
        "targets": ["ARGS", "BODY", "HEADERS", "REQUEST_COOKIES"],
        "severity": "HIGH",
        "action": "block",
        "score": 8,
         "description": "Block UNION SELECT, allowing whitespace, inline comments, or an opening paren as separator (union(select 1,2) is valid MySQL and bypassed the old pattern)."
    },
   {
        "id": "sqli-boolean-logic",
        "phase": 2,
         "pattern": "(?i)['\"]\\s*(?:and|or)\\s*['\"\\d]+\\s*(?:=|[<>]=?|!=)\\s*['\"\\d]+|\\)\\s*(?:and|or)\\s*\\(\\d+\\s*(?:=|[<>]=?|!=)\\s*\\d+\\)",
       "targets": ["ARGS", "BODY", "HEADERS", "REQUEST_COOKIES"],
         "severity": "HIGH",
         "action": "block",
         "score": 7,
         "description": "Block quote-context boolean tautologies in either quote style (\" or 1=1-- bypassed the single-quote-only pattern)."
    },
   {
        "id": "sqli-time-based-functions",
        "phase": 2,
        "pattern": "(?i)\\b(?:sleep|benchmark|pg_sleep)\\s*\\(|\\bwaitfor\\s+delay\\b",
       "targets": ["ARGS", "BODY", "HEADERS", "REQUEST_COOKIES"],
         "severity": "HIGH",
         "action": "block",
       "score": 7,
         "description": "Block timing-based blind injection: sleep/benchmark/pg_sleep calls and T-SQL WAITFOR DELAY, which takes no parenthesis -- the old waitfor\\s+delay\\s*\\( branch could never match valid T-SQL."
    },
    {
       "id": "sqli-comment-syntax",
       "phase": 2,
        "pattern": "(?i)/\\*.*?\\*/|--\\s*(\\r\\n?|$)",
        "targets": ["ARGS", "BODY", "HEADERS", "REQUEST_COOKIES"],
        "severity": "MEDIUM",
        "action": "log",
        "score": 4,
        "description": "Log potential SQLi comment bypass attempts."
   },
   {
