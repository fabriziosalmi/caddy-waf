    {
     "id": "sqli-advanced-blind-injection",
       "phase": 2,
       "pattern": "(?i)\\b(?:select|insert|update|delete|drop|alter)\\b.*?\\b(?:from|where|into|table)\\b.*?\\s(?:and|or)\\s+(?:\\d+\\s*=\\s*\\d+|'[^']{0,20}'\\s*=\\s*'[^']{0,20}'?|true\\b|false\\b)",
       "targets": ["ARGS", "BODY", "HEADERS", "REQUEST_COOKIES"],
        "severity": "HIGH",
        "action":"block",
