[
   {
        "id": "xss-basic",
        "phase": 2,
        "pattern": "(?i)<script[^>]*>",
        "targets": [ "ARGS", "BODY", "HEADERS" ],
        "severity": "HIGH",
        "action": "block",
        "score": 8,
         "description": "Block script tags. The closing-tag requirement was removed: an injected fragment does not need its own </script> to execute."
    },
    {
        "id": "xss-img-onerror",
        "phase": 2,
        "pattern": "(?i)<img[^>]*[\\s/]onerror\\s*=",
         "targets": [ "ARGS", "BODY", "HEADERS" ],
        "severity": "HIGH",
        "action": "block",
        "score": 8,
        "description": "Block img onerror handlers; / accepted as attribute separator (<img/src=x/onerror=...) and no closing > required."
    },
     {
        "id": "xss-iframe-srcdoc",
        "phase": 2,
       "pattern": "(?i)<iframe[^>]*[\\s/]srcdoc\\s*=",
        "targets": [ "ARGS", "BODY", "HEADERS" ],
        "severity": "HIGH",
        "action": "block",
        "score": 7,
        "description": "Block iframe srcdoc; / separator accepted, no closing > required."
    },
    {
      "id": "xss-svg-onload",
      "phase": 2,
      "pattern": "(?i)<svg[^>]*[\\s/]onload\\s*=",
      "targets": [ "ARGS", "BODY", "HEADERS" ],
        "severity": "HIGH",
        "action": "block",
        "score": 8,
        "description": "Block svg onload handlers; catches the classic <svg/onload=...> the old \\s+ requirement missed."
    },
        {
        "id": "xss-javascript-href",
        "phase": 2,
        "pattern": "(?i)javascript\\s*:\\s*(.*?)(?:\r|\n|;)?",
        "targets": [ "ARGS", "BODY", "HEADERS" ],
        "severity": "HIGH",
        "action": "block",
        "score": 7,
       "description": "XSS using javascript: protocol"
    },
    {
        "id": "xss-vbscript-href",
        "phase": 2,
        "pattern": "(?i)vbscript\\s*:\\s*(.*?)(?:\r|\n|;)?",
         "targets": [ "ARGS", "BODY", "HEADERS" ],
        "severity": "HIGH",
        "action": "block",
        "score": 7,
        "description": "XSS using vbscript: protocol"
    },
     {
        "id": "xss-event-handlers-on",
        "phase": 2,
        "pattern": "(?i)<[a-z][^>]{0,200}?[\\s/]on[a-z]{2,24}\\s*=",
       "targets": [ "ARGS", "BODY", "HEADERS" ],
        "severity": "HIGH",
        "action": "block",
        "score": 7,
       "description":"Block any on* event handler inside a tag (generic match replaces the fixed whitelist that missed ontoggle/onpointerdown/onanimationstart/...). Requires tag context so the bare word 'onclick=' in prose does not fire."
    },
    {
        "id": "xss-alert-function",
         "phase": 2,
        "pattern":"(?i)\\b(?:alert|confirm|prompt)\\(",
        "targets": [ "ARGS", "BODY", "HEADERS" ],
         "severity": "HIGH",
        "action": "block",
        "score": 7,
        "description": "Block JS dialog calls. No space allowed before the paren so prose like 'please confirm (by clicking)' does not match; confirm/prompt added (equivalent PoC primitives the old rule missed)."
    },
    {
        "id": "xss-document-cookie",
        "phase": 2,
         "pattern": "(?i)document\\s*\\.\\s*cookie",
         "targets": [ "ARGS", "BODY", "HEADERS" ],
         "severity": "HIGH",
         "action": "block",
         "score": 7,
        "description":"XSS with document.cookie"
    },
    {
       "id":"xss-document-location",
        "phase":2,
        "pattern":"(?i)document\\s*\\.\\s*location",
        "targets": [ "ARGS", "BODY", "HEADERS" ],
        "severity":"HIGH",
        "action":"block",
        "score": 7,
        "description": "XSS with document.location"
   },
   {
      "id": "xss-eval-function",
      "phase": 2,
      "pattern": "(?i)\\beval\\(",
      "targets": [ "ARGS", "BODY", "HEADERS" ],
      "severity": "HIGH",
      "action": "block",
       "score": 7,
       "description": "Block eval calls. \\b + no space: 'retrieval(cached)' and 'medieval (12th c.)' prose no longer match."
   }

]
